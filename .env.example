# LumenReview Environment Configuration

# Application
APP_ENV=development
API_PORT=8000
UI_PORT=8501
LOG_LEVEL=INFO

# Security
API_KEY=lumen-dev-secret-key-2026
ALLOW_ANONYMOUS=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/lumenreview.db
CHROMA_PERSIST_DIR=./data/chroma_db

# LLM Configuration
# Options: mock | gemini | openai | anthropic
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model Names
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# RAG & Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K_RETRIEVAL=5
MIN_CITATION_SIMILARITY=0.85
ENABLE_BM25_RERANK=true
